# 投资分析师系统环境变量配置示例
# 复制此文件为 .env 并填入真实的API密钥

# =============================================================================
# 数据源API密钥配置
# =============================================================================

# Financial Modeling Prep (可选)
# 注册地址: https://site.financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage (可选)
# 注册地址: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# FRED (Federal Reserve Economic Data) (可选)
# 注册地址: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# =============================================================================
# 缓存配置
# =============================================================================

# Redis配置 (可选，用于提高性能)
# 本地Redis: redis://localhost:6379/0
# 云端Redis: redis://username:password@host:port/0
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# =============================================================================
# 系统配置
# =============================================================================

# 是否使用真实数据源 (true/false)
USE_REAL_DATA=true

# 调试模式 (true/false)
DEBUG=false

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=investment_analyst.log

# 是否启用性能监控 (true/false)
ENABLE_PERFORMANCE_MONITORING=true

# 默认请求超时时间（秒）
DEFAULT_TIMEOUT=30

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=5

# =============================================================================
# OpenAI配置 (用于LLM分析)
# =============================================================================

# OpenAI API密钥
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI模型 (gpt-3.5-turbo, gpt-4, etc.)
OPENAI_MODEL=gpt-3.5-turbo