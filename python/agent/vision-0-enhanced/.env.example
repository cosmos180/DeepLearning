# Vision-0 Enhanced 环境配置
# 复制此文件为 .env 并填入你的配置

# OpenAI API Key（必填）
OPENAI_API_KEY=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

# 可选：自定义 API Base URL（如使用 OpenRouter 或第三方兼容接口）
# 对于 OpenRouter，请取消注释并使用此地址
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 可选：默认核心模型（用于创意写作和深度逻辑推理）
# 在 OpenRouter 上，你可以填例如 anthropic/claude-3.5-sonnet，或 meta-llama/llama-3-70b-instruct
DEFAULT_MODEL=anthropic/claude-opus-4.6

# 可选：快速分类/反思模型（用于自我反思评估，需要速度快、便宜的模型）
FAST_MODEL=z-ai/glm-5
