# Tupu BI MCP Server 测试环境变量配置
# 复制此文件为 .env 并填入真实值

# API 基础地址（可选，默认为 https://api.bi.tuputech.com）
TUPI_BI_API_BASE=https://api.bi.tuputech.com

# 认证密钥（必填）
TUPI_BI_AUTH_SECRET=your-secret-here

# 测试用 Token ID（必填）
TUPI_BI_TEST_TOKEN_ID=your-token-id-here

# 测试用设备 MAC 地址（必填）
TUPI_BI_TEST_DEVICE_MAC=aa:bb:cc:dd:ee:ff

# 测试用设备序列号（必填）
TUPI_BI_TEST_DEVICE_SERIAL=your-serial-number-here

# 测试用客户 UID（用于 get_customer_info 测试，可选）
TUPI_BI_TEST_CUSTOMER_UID=682ffb703953c231e8cc46a7

# 测试用门店 SID（用于 get_store_info 测试，可选）
TUPI_BI_TEST_STORE_SID=682ffbae23e8639b53ec6aad
