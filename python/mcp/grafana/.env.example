# Grafana 告警邮件配置示例
# 复制此文件为 .env 并填入真实值
# 注意: .env 文件已在 .gitignore 中，不会被提交到版本控制

# SMTP 服务器配置
# 腾讯企业邮箱
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
# 端口 465 使用 SSL (SMTP_USE_TLS=false)
# 端口 587 使用 TLS (SMTP_USE_TLS=true)
SMTP_USE_TLS=false

# 其他常用 SMTP 服务器:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
# QQ邮箱: SMTP_HOST=smtp.qq.com, SMTP_PORT=587, SMTP_USE_TLS=true
# 163邮箱: SMTP_HOST=smtp.163.com, SMTP_PORT=465, SMTP_USE_TLS=false

# 发件人配置
SENDER_EMAIL=jinxinhou@tuputech.com
SENDER_PASSWORD="$R9RVp#rAeGRUh2"
SENDER_NAME=[Grafana-Alert-System]

# 收件人配置 (逗号分隔)
RECIPIENTS_TO=jinxinhou@tuputech.com
# RECIPIENTS_CC=manager@example.com
