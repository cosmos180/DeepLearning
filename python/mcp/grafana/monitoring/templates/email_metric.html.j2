<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        .alert-container { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; max-width: 800px; margin: 0 auto; }
        .alert-header { background: #ff9800; color: white; padding: 20px; border-radius: 5px 5px 0 0; }
        .alert-header.critical { background: #f44336; }
        .alert-header.info { background: #2196f3; }
        .alert-body { background: #f5f5f5; padding: 20px; border: 1px solid #ddd; }
        .summary-table { width: 100%; border-collapse: collapse; margin: 10px 0; }
        .summary-table th, .summary-table td { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
        .summary-table th { background: #f0f0f0; font-weight: 600; }
        .metric-value { font-size: 24px; font-weight: bold; color: #f44336; }
        .threshold-value { font-size: 18px; color: #666; }
        .footer { font-size: 12px; color: #666; margin-top: 20px; text-align: center; }
        .timestamp { color: rgba(255,255,255,0.9); font-size: 14px; }
        .link-button { display: inline-block; padding: 10px 20px; background: #2196f3; color: white; text-decoration: none; border-radius: 5px; margin: 5px; }
        .link-button:hover { background: #1976d2; }
        .data-table { width: 100%; border-collapse: collapse; margin: 15px 0; }
        .data-table th { background: #f0f0f0; padding: 10px; text-align: left; font-weight: 600; }
        .data-table td { padding: 10px; border-bottom: 1px solid #ddd; }
        .data-table tr:hover { background: #f9f9f9; }
    </style>
</head>
<body>
    <div class="alert-container">
        <!-- 告警头部 -->
        <div class="alert-header {{ severity_class }}">
            <h1>{{ alert_icon }} {{ alert_title }}</h1>
            <p class="timestamp">触发时间: {{ triggered_at }}</p>
        </div>

        <!-- 告警主体 -->
        <div class="alert-body">
            <!-- 摘要信息 -->
            <h2>告警摘要</h2>
            <table class="summary-table">
                <tr><th>严重程度</th><td>{{ severity }}</td></tr>
                <tr><th>规则名称</th><td>{{ rule_name }}</td></tr>
                <tr><th>指标名称</th><td>{{ metric_name }}</td></tr>
                <tr><th>当前值</th><td><span class="metric-value">{{ actual_value }}</span></td></tr>
                <tr><th>阈值</th><td><span class="threshold-value">{{ threshold_value }}</span></td></tr>
                <tr><th>持续时间</th><td>{{ duration }}</td></tr>
            </table>

            <!-- 指标图表 -->
            {% if grafana_chart_url %}
            <h2>指标趋势</h2>
            <div style="text-align: center; margin: 20px 0;">
                <img src="{{ grafana_chart_url }}" alt="Metric Trend Chart" style="max-width: 100%; border-radius: 5px;" />
            </div>
            {% endif %}

            <!-- 数据明细 -->
            <h2>数据明细</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>时间</th>
                        <th>值</th>
                        <th>阈值</th>
                        <th>状态</th>
                    </tr>
                </thead>
                <tbody>
                    {% for point in metric_data[:20] %}
                    <tr>
                        <td>{{ point.timestamp }}</td>
                        <td>{{ point.value }}</td>
                        <td>{{ point.threshold }}</td>
                        <td>{% if point.value > point.threshold %}⚠️ 超标{% else %}✅ 正常{% endif %}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            <!-- 相关链接 -->
            <h2>相关链接</h2>
            <a href="{{ kibana_url }}" class="link-button">在 Kibana 中查看</a>
            {% if grafana_dashboard_url %}
            <a href="{{ grafana_dashboard_url }}" class="link-button">在 Grafana 中查看</a>
            {% endif %}
            {% if runbook_url %}
            <a href="{{ runbook_url }}" class="link-button">处理手册</a>
            {% endif %}
        </div>

        <!-- 页脚 -->
        <div class="footer">
            <p>本告警由 ElastAlert 监控系统生成</p>
            <p>规则: {{ rule_name }} | 触发时间: {{ triggered_at }}</p>
        </div>
    </div>
</body>
</html>
