<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        .alert-container { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; max-width: 800px; margin: 0 auto; }
        .alert-header { background: #f44336; color: white; padding: 20px; border-radius: 5px 5px 0 0; }
        .alert-header.warning { background: #ff9800; }
        .alert-header.info { background: #2196f3; }
        .alert-body { background: #f5f5f5; padding: 20px; border: 1px solid #ddd; }
        .error-details { background: white; padding: 15px; margin: 10px 0; border-left: 4px solid #f44336; }
        .summary-table { width: 100%; border-collapse: collapse; margin: 10px 0; }
        .summary-table th, .summary-table td { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
        .summary-table th { background: #f0f0f0; font-weight: 600; }
        .code-block { background: #1e1e1e; color: #d4d4d4; padding: 15px; border-radius: 5px; overflow-x: auto; font-family: 'Courier New', monospace; font-size: 12px; line-height: 1.4; }
        .footer { font-size: 12px; color: #666; margin-top: 20px; text-align: center; }
        .timestamp { color: rgba(255,255,255,0.9); font-size: 14px; }
        .link-button { display: inline-block; padding: 10px 20px; background: #2196f3; color: white; text-decoration: none; border-radius: 5px; margin: 5px; }
        .link-button:hover { background: #1976d2; }
    </style>
</head>
<body>
    <div class="alert-container">
        <!-- 告警头部 -->
        <div class="alert-header {{ severity_class }}">
            <h1>{{ alert_icon }} {{ alert_title }}</h1>
            <p class="timestamp">触发时间: {{ triggered_at }}</p>
        </div>

        <!-- 告警主体 -->
        <div class="alert-body">
            <!-- 摘要信息 -->
            <h2>告警摘要</h2>
            <table class="summary-table">
                <tr><th>严重程度</th><td>{{ severity }}</td></tr>
                <tr><th>规则名称</th><td>{{ rule_name }}</td></tr>
                <tr><th>服务名称</th><td>{{ service_name }}</td></tr>
                <tr><th>环境</th><td>{{ environment }}</td></tr>
                <tr><th>匹配数量</th><td>{{ num_hits }} (最近 {{ time_range }})</td></tr>
            </table>

            <!-- 错误详情 -->
            <h2>错误详情</h2>
            {% for hit in hits[:10] %}
            <div class="error-details">
                <p><strong>时间:</strong> {{ hit._source.get('@timestamp', 'N/A') }}</p>
                {% if hit._source.get('service_name') %}
                <p><strong>服务:</strong> {{ hit._source.service_name }}</p>
                {% endif %}
                {% if hit._source.get('level') %}
                <p><strong>级别:</strong> {{ hit._source.level }}</p>
                {% endif %}
                {% if hit._source.get('message') %}
                <p><strong>消息:</strong> {{ hit._source.message }}</p>
                {% endif %}
                {% if hit._source.get('error_type') %}
                <p><strong>错误类型:</strong> {{ hit._source.error_type }}</p>
                {% endif %}
                {% if hit._source.get('hostname') %}
                <p><strong>主机:</strong> {{ hit._source.hostname }}</p>
                {% endif %}
                {% if hit._source.get('stack_trace') %}
                <p><strong>堆栈跟踪:</strong></p>
                <div class="code-block">
                    <pre>{{ hit._source.stack_trace }}</pre>
                </div>
                {% endif %}
            </div>
            {% endfor %}

            <!-- 相关链接 -->
            <h2>相关链接</h2>
            <a href="{{ kibana_url }}" class="link-button">在 Kibana 中查看</a>
            {% if grafana_url %}
            <a href="{{ grafana_url }}" class="link-button">在 Grafana 中查看</a>
            {% endif %}
            {% if runbook_url %}
            <a href="{{ runbook_url }}" class="link-button">处理手册</a>
            {% endif %}
        </div>

        <!-- 页脚 -->
        <div class="footer">
            <p>本告警由 ElastAlert 监控系统生成</p>
            <p>规则: {{ rule_name }} | 触发时间: {{ triggered_at }}</p>
        </div>
    </div>
</body>
</html>
