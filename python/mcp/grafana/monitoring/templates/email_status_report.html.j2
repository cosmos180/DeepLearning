<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background-color: white;
        }
        .header {
            padding: 24px;
            color: white;
        }
        .header.success {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        }
        .header.warning {
            background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
        }
        .header.critical {
            background: linear-gradient(135deg, #dc3545 0%, #c7254e 100%);
        }
        .header.info {
            background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        }
        .header h1 {
            margin: 0 0 8px 0;
            font-size: 24px;
            font-weight: 600;
        }
        .header p {
            margin: 0;
            opacity: 0.9;
            font-size: 14px;
        }
        .content {
            padding: 24px;
        }
        .status-box {
            padding: 16px;
            border-radius: 8px;
            margin: 16px 0;
        }
        .status-box.success {
            background-color: #d4edda;
            border-left: 4px solid #28a745;
        }
        .status-box.warning {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
        }
        .status-box.critical {
            background-color: #f8d7da;
            border-left: 4px solid #dc3545;
        }
        .status-box h3 {
            margin: 0 0 8px 0;
            font-size: 16px;
        }
        .status-box p {
            margin: 0;
            color: #666;
        }
        .info-box {
            background-color: #f8f9fa;
            padding: 16px;
            border-radius: 8px;
            margin: 16px 0;
        }
        .info-box h4 {
            margin: 0 0 12px 0;
            font-size: 14px;
            color: #495057;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .info-box ul {
            margin: 0;
            padding-left: 20px;
        }
        .info-box li {
            margin-bottom: 8px;
            color: #495057;
        }
        .info-box li strong {
            color: #212529;
        }
        .alert-table {
            width: 100%;
            border-collapse: collapse;
            margin: 16px 0;
        }
        .alert-table th {
            background-color: #f8f9fa;
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid #dee2e6;
        }
        .alert-table td {
            padding: 12px;
            border-bottom: 1px solid #dee2e6;
        }
        .alert-table tr:hover {
            background-color: #f8f9fa;
        }
        .severity-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        .severity-badge.critical {
            background-color: #f8d7da;
            color: #721c24;
        }
        .severity-badge.warning {
            background-color: #fff3cd;
            color: #856404;
        }
        .severity-badge.info {
            background-color: #d1ecf1;
            color: #0c5460;
        }
        .code-block {
            background-color: #f8f9fa;
            padding: 12px;
            border-radius: 6px;
            font-family: 'Monaco', 'Menlo', monospace;
            font-size: 12px;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-all;
        }
        .footer {
            padding: 20px 24px;
            color: #6c757d;
            font-size: 13px;
            border-top: 1px solid #dee2e6;
        }
        .footer p {
            margin: 4px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header {{ header_class }}">
            <h1>{{ title }}</h1>
            <p>{{ subtitle }}</p>
        </div>

        <!-- Content -->
        <div class="content">
            <!-- Status Box -->
            <div class="status-box {{ status_class }}">
                <h3>{{ status_title }}</h3>
                <p>{{ status_message }}</p>
            </div>

            <!-- Info Box -->
            <div class="info-box">
                <h4>{{ info_box_title }}</h4>
                {{ info_box_content|safe }}
            </div>

            {% if details_content %}
            <!-- Details -->
            <div class="info-box">
                <h4>详细信息</h4>
                {{ details_content|safe }}
            </div>
            {% endif %}

            {% if alert_list %}
            <!-- Alert Table -->
            <div class="info-box" style="padding: 0; overflow: hidden;">
                <h4 style="margin: 16px 16px 12px 16px;">告警详情</h4>
                <table class="alert-table" style="margin: 0;">
                    <thead>
                        <tr>
                            <th width="12%">级别</th>
                            <th width="22%">规则名称</th>
                            <th width="18%">设备 ID</th>
                            <th width="14%">当前值</th>
                            <th width="14%">阈值</th>
                            <th width="20%">时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for alert in alert_list %}
                        <tr>
                            <td>
                                <span class="severity-badge {{ alert.severity_class }}">{{ alert.severity_text }}</span>
                            </td>
                            <td>{{ alert.rule_name }}</td>
                            <td style="font-family: monospace; font-size: 13px;">{{ alert.device_id }}</td>
                            <td style="font-weight: 600; color: {{ alert.value_color }};">{{ alert.value }}</td>
                            <td>{{ alert.threshold }}</td>
                            <td style="font-size: 13px; color: #6c757d;">{{ alert.timestamp }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if alert_list_more %}
                <p style="margin: 12px 16px; color: #6c757d; font-size: 13px;">
                    ... 还有 {{ alert_list_more }} 条告警
                </p>
                {% endif %}
            </div>
            {% endif %}
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>{{ footer_message }}</p>
            <p>Platform: {{ platform }} | Generated: {{ generated_at }}</p>
        </div>
    </div>
</body>
</html>
