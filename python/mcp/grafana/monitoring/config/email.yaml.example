# 邮件服务器配置
# 请根据你的邮件服务商修改以下配置

# SMTP 服务器配置
# 支持环境变量: ${SMTP_HOST}, ${SMTP_PORT}, ${SMTP_USE_TLS}
smtp:
  # SMTP 服务器地址
  # 腾讯企业邮箱: smtp.exmail.qq.com
  # Gmail: smtp.gmail.com
  # QQ邮箱: smtp.qq.com
  # 163邮箱: smtp.163.com
  host: "${SMTP_HOST:-smtp.exmail.qq.com}"
  # SMTP 端口 (465 for SSL, 587 for TLS)
  port: ${SMTP_PORT:-465}
  # 是否使用 TLS (端口 465 用 false, 端口 587 用 true)
  use_tls: "${SMTP_USE_TLS:-false}"

# 发件人认证
# 支持环境变量: ${SENDER_EMAIL}, ${SENDER_PASSWORD}
sender:
  # 发件人邮箱
  email: "${SENDER_EMAIL:-your-name@company.com}"
  # 邮箱密码或应用专用密码
  # 腾讯企业邮箱: 使用邮箱登录密码或客户端专用密码
  # Gmail: 需要使用应用专用密码
  # QQ邮箱: 使用授权码
  password: "${SENDER_PASSWORD:-your-password}"
  # 发件人显示名称
  name: "${SENDER_NAME:-Grafana Alert System}"

# 收件人配置
# 支持环境变量: ${RECIPIENTS_TO}, ${RECIPIENTS_CC}
recipients:
  # 默认收件人列表 (逗号分隔或 YAML 数组)
  to: ${RECIPIENTS_TO:-["ops@example.com", "admin@example.com"]}
  # 抄送列表 (可选)
  cc: ${RECIPIENTS_CC:-["manager@example.com"]}
  # 密送列表 (可选)
  bcc: []

# 告警级别路由 (可选)
# 根据告警级别发送给不同的收件人
severity_routes:
  critical:
    to:
      - "oncall@example.com"
  warning:
    to:
      - "team@example.com"

# 邮件模板配置
templates:
  # 主题模板
  subject_template: "[{severity}] {rule_name} - {device_id}"
  # HTML 模板路径 (可选，默认使用内置模板)
  html_template: "monitoring/templates/alert_email.html"
